// Blood Bank Management System - Complete Database Schema
// Analyzed from all frontend pages and requirements

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// USER & AUTHENTICATION
// ═══════════════════════════════════════════════════════════════════════════

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  phone      String
  role       Role     @default(DONOR)
  isVerified Boolean  @default(false)
  
  // OAuth
  googleId      String?  @unique
  
  // Email verification
  emailVerified Boolean  @default(false)
  otp           String?
  otpExpiry     DateTime?
  
  // Profile
  profilePicture String?  // URL to profile picture
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  donor             Donor?
  donations         Donation[]
  certificates      Certificate[]
  eventParticipations EventParticipant[]
  eventVolunteers   EventVolunteer[]
  bloodIssues       BloodIssue[]
  notifications     Notification[]

  @@index([email])
  @@index([phone])
  @@index([googleId])
}

// ═══════════════════════════════════════════════════════════════════════════
// DONOR MANAGEMENT (from donors page)
// ═══════════════════════════════════════════════════════════════════════════

model Donor {
  id              String    @id @default(cuid())
  userId          String    @unique
  bloodGroup      BloodGroup
  donorType       DonationType @default(PERSON)  // Type: PERSON or ORGANIZATION
  location        String
  city            String?
  address         String?
  dateOfBirth     DateTime?
  
  // Geolocation for blood search map
  latitude        Float?
  longitude       Float?
  
  // Donation tracking
  lastDonationDate DateTime?
  totalDonations  Int       @default(0)
  isEligible      Boolean   @default(true)
  
  // Medical info
  weight          Float?
  medicalNotes    String?
  
  // Verification status
  verificationStatus DonorVerificationStatus @default(PENDING)
  verifiedAt      DateTime?
  verifiedBy      String?   // User ID of the person who verified
  rejectionReason String?   // Reason if rejected
  
  // Re-verification fields
  reverificationRequested Boolean @default(false)
  reverificationMessage   String?  // Message from donor requesting re-verification
  reverificationRequestedAt DateTime?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodPacks      BloodPack[]

  @@index([bloodGroup])
  @@index([location])
  @@index([isEligible])
  @@index([latitude, longitude])
  @@index([donorType])
  @@index([verificationStatus])
}

// ═══════════════════════════════════════════════════════════════════════════
// BLOOD STOCK MANAGEMENT (from blood-stock page)
// ═══════════════════════════════════════════════════════════════════════════

model BloodPack {
  id              String      @id @default(cuid())
  packCode        String      @unique
  bloodGroup      BloodGroup
  donorId         String?
  donationId      String?     // Link to the donation that created this pack
  
  // Dates
  collectionDate  DateTime
  expiryDate      DateTime
  
  // Status tracking
  status          PackStatus  @default(AVAILABLE)
  
  // Location
  storageLocation String?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  donor           Donor?      @relation(fields: [donorId], references: [id], onDelete: SetNull)
  donation        Donation?   @relation(fields: [donationId], references: [id], onDelete: SetNull)
  bloodIssueItems BloodIssueItem[]

  @@index([bloodGroup])
  @@index([status])
  @@index([expiryDate])
  @@index([packCode])
  @@index([donationId])
}

// Aggregate stock view (for dashboard)
model BloodStockSummary {
  id          String     @id @default(cuid())
  bloodGroup  BloodGroup @unique
  available   Int        @default(0)
  used        Int        @default(0)
  expired     Int        @default(0)
  total       Int        @default(0)
  lastUpdated DateTime   @default(now())
  
  @@index([bloodGroup])
}

// ═══════════════════════════════════════════════════════════════════════════
// BLOOD DONATION & ISSUANCE (from blood-donate pages)
// ═══════════════════════════════════════════════════════════════════════════

model Donation {
  id              String         @id @default(cuid())
  userId          String
  donorId         String?
  eventId         String?        // Link to event if collected during event
  
  // Donation details
  bloodGroup      BloodGroup
  units           Int            @default(1)
  donationDate    DateTime       @default(now())
  location        String
  
  // Type: person or organization
  donationType    DonationType   @default(PERSON)
  
  // Status
  status          DonationStatus @default(COMPLETED)
  
  // Additional info
  notes           String?
  contact         String?
  storageLocation String?        // Storage location for the blood pack
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event           Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  bloodPacks      BloodPack[]    // Blood packs created from this donation

  @@index([userId])
  @@index([eventId])
  @@index([bloodGroup])
  @@index([donationDate])
  @@index([donationType])
}

// Blood Issue/Distribution (from donate-form page)
model BloodIssue {
  id              String         @id @default(cuid())
  issueCode       String         @unique
  
  // Recipient details
  recipientName   String
  recipientType   RecipientType  @default(PERSON)
  bloodGroup      BloodGroup
  unitsRequested  Int
  unitsIssued     Int
  
  // Contact
  contact         String
  
  // Issue details
  issueDate       DateTime       @default(now())
  issuedBy        String?
  
  // Status
  status          IssueStatus    @default(COMPLETED)
  
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  issuedBy_user   User?          @relation(fields: [issuedBy], references: [id], onDelete: SetNull)
  bloodPacksIssued BloodIssueItem[]
  bloodRequests   BloodRequest[] // Link to blood requests that resulted in this issue

  @@index([bloodGroup])
  @@index([issueDate])
  @@index([recipientType])
}

// Junction table for blood packs issued
model BloodIssueItem {
  id            String     @id @default(cuid())
  bloodIssueId  String
  bloodPackId   String
  createdAt     DateTime   @default(now())

  bloodIssue    BloodIssue @relation(fields: [bloodIssueId], references: [id], onDelete: Cascade)
  bloodPack     BloodPack  @relation(fields: [bloodPackId], references: [id], onDelete: Cascade)

  @@unique([bloodIssueId, bloodPackId])
  @@index([bloodIssueId])
  @@index([bloodPackId])
}

// ═══════════════════════════════════════════════════════════════════════════
// EVENTS MANAGEMENT (from events page)
// ═══════════════════════════════════════════════════════════════════════════

model Event {
  id              String      @id @default(cuid())
  title           String
  description     String?
  location        String
  eventDate       DateTime
  
  // Images
  banner          String?     // Banner image URL
  poster          String?     // Poster image URL
  
  // Location coordinates
  latitude        Float?      // For map display
  longitude       Float?      // For map display
  
  // Status
  status          EventStatus @default(UPCOMING)
  
  // Capacity
  capacity        Int?
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  participants    EventParticipant[]
  volunteers      EventVolunteer[]
  donations       Donation[]  // Donations collected during this event

  @@index([eventDate])
  @@index([status])
}

// Event participants (donors who will donate)
model EventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    ParticipantStatus @default(REGISTERED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Event volunteers (helpers)
model EventVolunteer {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  
  // Volunteer details (for non-user volunteers)
  name      String?
  email     String?
  phone     String?
  address   String?
  
  role      String?
  status    VolunteerStatus @default(REGISTERED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// CERTIFICATES (from certificates page)
// ═══════════════════════════════════════════════════════════════════════════

model Certificate {
  id                String          @id @default(cuid())
  certificateNumber String          @unique
  
  // Type: donation or volunteer
  type              CertificateType @default(DONATION)
  
  // Recipient
  userId            String
  recipientName     String
  
  // For volunteer certificates
  eventTitle        String?
  volunteerId       String?
  
  // Issue details
  issueDate         DateTime        @default(now())
  
  createdAt         DateTime        @default(now())

  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([certificateNumber])
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  DONOR
  ADMIN
  STAFF
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum PackStatus {
  AVAILABLE
  USED
  EXPIRED
  RESERVED
}

enum DonationType {
  PERSON
  ORGANIZATION
}

enum RecipientType {
  PERSON
  ORGANIZATION
  HOSPITAL
}

enum DonationStatus {
  PENDING
  COMPLETED
  CANCELLED
  REJECTED
}

enum IssueStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum EventStatus {
  UPCOMING
  RUNNING
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum VolunteerStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum CertificateType {
  DONATION
  VOLUNTEER
}

enum DonorVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ═══════════════════════════════════════════════════════════════════════════
// GALLERY MANAGEMENT (for public images page)
// ═══════════════════════════════════════════════════════════════════════════

model Gallery {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String
  imageKey    String?  // For cloud storage reference
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([order])
}

// ═══════════════════════════════════════════════════════════════════════════
// ABOUT PAGE CONTENT MANAGEMENT
// ═══════════════════════════════════════════════════════════════════════════

model About {
  id          String   @id @default(cuid())
  
  // Hero Section
  heroTitle       String   @default("About VitalFlow")
  heroSubtitle    String   @default("We're on a mission to make blood donation accessible, efficient, and impactful for everyone.")
  
  // Mission & Vision
  missionTitle    String   @default("Our Mission")
  missionContent  String   @default("To create a seamless bridge between blood donors and those in need, ensuring that no life is lost due to blood shortage.")
  visionTitle     String   @default("Our Vision")
  visionContent   String   @default("A world where every person has access to safe blood when they need it.")
  
  // Values (stored as JSON)
  values          String   @default("[{\"title\":\"Community First\",\"description\":\"We believe in the power of community and collective action to save lives.\",\"icon\":\"Users\"},{\"title\":\"Excellence\",\"description\":\"We maintain the highest standards in blood collection, storage, and distribution.\",\"icon\":\"Award\"},{\"title\":\"Compassion\",\"description\":\"Every interaction is guided by empathy and understanding of the critical nature of our work.\",\"icon\":\"Heart\"}]")
  
  // Story Section
  storyTitle      String   @default("Our Story")
  storyContent    String   @default("VitalFlow was founded with a simple yet powerful idea: use technology to save lives through better blood donation management.")
  
  // Stats (stored as JSON)
  stats           String   @default("[{\"label\":\"Active Donors\",\"value\":\"500+\"},{\"label\":\"Partner Hospitals\",\"value\":\"25+\"},{\"label\":\"Blood Units Collected\",\"value\":\"3,000+\"}]")
  
  // Contact Information
  contactAddress  String   @default("123 Blood Bank Street, Medical District, City 12345")
  contactPhone    String   @default("+1 (555) 123-4567")
  contactEmail    String   @default("info@bloodbank.org")
  contactEmergency String  @default("+1 (555) 999-BLOOD")
  
  // WhatsApp Contact (for blood requests)
  whatsappNumber  String?  @default("+977-9800000000")
  whatsappEnabled Boolean  @default(true)
  
  // What We Do sections (stored as JSON)
  whatWeDo        String   @default("[{\"title\":\"Blood Collection\",\"description\":\"We organize regular blood donation camps and operate mobile collection units.\"},{\"title\":\"Testing & Processing\",\"description\":\"Every unit of blood is thoroughly tested and processed following international standards.\"},{\"title\":\"Storage & Distribution\",\"description\":\"We maintain state-of-the-art storage facilities and efficient distribution systems.\"},{\"title\":\"Community Engagement\",\"description\":\"We conduct awareness programs, donor recruitment drives, and educational initiatives.\"}]")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS SYSTEM
// ═══════════════════════════════════════════════════════════════════════════

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  link        String?  // Optional link to related resource
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  EVENT_ALERT
  BLOOD_REQUEST
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  VERIFICATION_UNVERIFIED
  CERTIFICATE_ISSUED
  DONATION_REMINDER
  GENERAL
}

// ═══════════════════════════════════════════════════════════════════════════
// BLOOD REQUEST SYSTEM (Public blood requests from /need-a-blood)
// ═══════════════════════════════════════════════════════════════════════════

model BloodRequest {
  id              String              @id @default(cuid())
  
  // Requester details
  name            String
  phone           String
  email           String?
  address         String
  
  // Request details
  bloodGroup      BloodGroup
  unitsNeeded     Int                 @default(1)
  urgency         RequestUrgency      @default(NORMAL)
  neededBy        DateTime            // Date and time when blood is needed
  
  // Status
  status          BloodRequestStatus  @default(PENDING)
  
  // Admin actions
  reviewedBy      String?             // Admin user ID who reviewed
  reviewedAt      DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  
  // Stock check
  stockAvailable  Boolean?            // Whether stock is available
  stockCheckedAt  DateTime?
  
  // Fulfillment
  fulfilledAt     DateTime?
  fulfilledBy     String?             // User ID who fulfilled the request
  bloodIssueId    String?             // Link to blood issue record
  
  notes           String?
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  bloodIssue      BloodIssue?         @relation(fields: [bloodIssueId], references: [id], onDelete: SetNull)
  
  @@index([status])
  @@index([bloodGroup])
  @@index([neededBy])
  @@index([createdAt])
}

enum BloodRequestStatus {
  PENDING       // Submitted, waiting for admin review
  APPROVED      // Admin approved, stock available
  REJECTED      // Admin rejected
  FULFILLED     // Blood issued to requester
  CANCELLED     // Requester cancelled
  EXPIRED       // Request expired (past neededBy date)
}

enum RequestUrgency {
  NORMAL
  URGENT
  EMERGENCY
}
 