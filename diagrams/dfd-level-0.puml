@startuml Blood Stock Management System - DFD Level 0

' Styling
skinparam defaultTextAlignment center
skinparam process {
    BackgroundColor #E3F2FD
    BorderColor #1976D2
    FontSize 11
}
skinparam storage {
    BackgroundColor #FFF9C4
    BorderColor #F57C00
}
skinparam actor {
    BackgroundColor #FFE0B2
    BorderColor #E64A19
}

title Blood Stock Management System\nData Flow Diagram - Level 0

' External Entities
actor "Donor" as donor
actor "Staff" as staff
actor "Admin" as admin
actor "Recipient" as recipient

' Main Processes
rectangle "1.0\nUser\nAuthentication\n& Management" as P1 #E3F2FD
rectangle "2.0\nDonor\nManagement" as P2 #C8E6C9
rectangle "3.0\nDonation\nProcessing" as P3 #BBDEFB
rectangle "4.0\nInventory\nManagement" as P4 #FFCCBC
rectangle "5.0\nBlood\nIssuance" as P5 #F8BBD0
rectangle "6.0\nEvent\nManagement" as P6 #E1BEE7
rectangle "7.0\nCertificate\nGeneration" as P7 #B2DFDB
rectangle "8.0\nReporting\n& Analytics" as P8 #FFF9C4

' Data Stores
database "D1: Users" as D1 #FFF9C4
database "D2: Donors" as D2 #FFF9C4
database "D3: Donations" as D3 #FFF9C4
database "D4: Blood Packs" as D4 #FFF9C4
database "D5: Blood Issues" as D5 #FFF9C4
database "D6: Events" as D6 #FFF9C4
database "D7: Certificates" as D7 #FFF9C4
database "D8: Blood Stock\nSummary" as D8 #FFF9C4

' Donor Flows
donor --> P1 : Registration\nDetails
donor --> P2 : Donor\nInformation
donor --> P3 : Donation\nDetails
donor --> P6 : Event\nRegistration
P1 --> donor : Login\nCredentials
P2 --> donor : Eligibility\nStatus
P3 --> donor : Donation\nConfirmation
P7 --> donor : Certificate
P6 --> donor : Event\nDetails

' Staff Flows
staff --> P1 : Login\nRequest
staff --> P2 : Donor\nRecords
staff --> P3 : Record\nDonation
staff --> P4 : Blood Pack\nData
staff --> P5 : Issuance\nRequest
staff --> P6 : Event\nData
P1 --> staff : Access\nToken
P2 --> staff : Donor\nList
P4 --> staff : Stock\nStatus
P5 --> staff : Issuance\nReceipt
P8 --> staff : Reports

' Admin Flows
admin --> P1 : User\nManagement
admin --> P8 : Report\nRequests
P1 --> admin : User\nData
P8 --> admin : Analytics\nReports

' Recipient Flows
recipient --> P5 : Blood\nRequest
P5 --> recipient : Blood\nAvailability
P5 --> recipient : Issuance\nReceipt

' Process to Data Store Flows
P1 <--> D1 : User\nData
P2 <--> D2 : Donor\nData
P3 <--> D3 : Donation\nRecords
P4 <--> D4 : Blood Pack\nData
P5 <--> D5 : Issuance\nRecords
P6 <--> D6 : Event\nData
P7 <--> D7 : Certificate\nData
P4 <--> D8 : Stock\nSummary

' Inter-Process Flows
P1 --> P2 : Authenticated\nUser
P2 --> P3 : Donor\nDetails
P3 --> P4 : Blood Pack\nCreation
P4 --> P5 : Available\nBlood
P6 --> P3 : Event\nDonations
P3 --> P7 : Donation\nHistory
P2 --> P8 : Donor\nStatistics
P3 --> P8 : Donation\nData
P4 --> P8 : Inventory\nData
P5 --> P8 : Issuance\nData

note bottom of P1
  Handles user authentication,
  authorization, and role-based
  access control
end note

note bottom of P4
  Tracks blood inventory,
  monitors expiry dates,
  manages stock levels
end note

@enduml
